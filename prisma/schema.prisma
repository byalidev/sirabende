generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  USER
  ADMIN
  SUPER_ADMIN
}

enum RequestStatus {
  ACTIVE
  CLOSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RequestCondition {
  NEW
  USED
  REFURBISHED
  UNKNOWN
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum OfferWarrantyType {
  NONE
  SELLER
  MANUFACTURER
  STORE
}

enum NotificationType {
  NEW_OFFER
  OFFER_ACCEPTED
  NEW_MESSAGE
  REQUEST_EXPIRED
  REQUEST_STATUS_CHANGED
  SYSTEM
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum ModerationType {
  GENERAL_BAN
  POSTING_BAN
  OFFERING_BAN
  ACCOUNT_DEACTIVATION
}

enum StrikeLevel {
  LOW
  MEDIUM
  HIGH
}

enum StrikeReason {
  SPAM
  UNNECESSARY_MESSAGE
  WRONG_CATEGORY
  MINOR_PROFILE_VIOLATION
  MISLEADING_PRODUCT_INFO
  FAKE_REQUEST
  REPEATED_SPAM
  FAKE_REVIEW
  OFF_PLATFORM_REDIRECTION
  FRAUD
  FAKE_IDENTITY
  FAKE_BUSINESS
  THREAT
  BLACKMAIL
  PERSONAL_DATA_MISUSE
  PROHIBITED_PRODUCT
}

enum StrikeStatus {
  ACTIVE
  REVOKED
}

enum MessageModerationType {
  PROFANITY
  PHONE_NUMBER
  BANKING
  EXTERNAL_CONTACT
  SUSPICIOUS_CONTENT
}

enum MessageModerationSeverity {
  LOW
  MEDIUM
  HIGH
}

enum MessageModerationReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
  IN_REVIEW
}

enum AdminActionType {
  ADMIN_CREATED
  ADMIN_STATUS_CHANGED
  ADMIN_ROLE_CHANGED
  ADMIN_BAN_USER
  ADMIN_UNBAN_USER
  ADMIN_REVOKE_SANCTION
  ADMIN_DELETE_REQUEST
  ADMIN_DELETE_OFFER
  ADMIN_APPLY_SANCTION
  ADMIN_REVIEW_REPORT
  ADMIN_REVIEW_MESSAGE
  ADMIN_DELETE_REPORT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String
  ownerKey     String?  @unique
  firstName    String?
  lastName     String?
  phone        String?
  avatar       String?
  bio          String?
  city         String?
  district     String?
  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)
  emailVerifiedAt DateTime?
  bannedUntil  DateTime?
  postingBannedUntil DateTime?
  offeringBannedUntil DateTime?
  lowStrikeCount Int @default(0)
  mediumStrikeCount Int @default(0)
  highStrikeCount Int @default(0)
  permanentlySuspendedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles           UserRole[]
  requests            Request[]
  offers              Offer[]
  notifications       Notification[]
  favoriteRequests    FavoriteRequest[]
  sentMessages        Message[]         @relation("MessageSender")
  conversationsBuyer  Conversation[]    @relation("ConversationBuyer")
  conversationsSeller Conversation[]    @relation("ConversationSeller")
  reviewsWritten      Review[]          @relation("ReviewWritten")
  reviewsReceived     Review[]          @relation("ReviewReceived")
  reportsFiled        Report[]          @relation("ReportFiled")
  reportsReceived     Report[]          @relation("ReportReceived")
  blocksInitiated     UserBlock[]       @relation("BlockInitiator")
  blocksReceived      UserBlock[]       @relation("BlockTarget")
  sessions            Session[]
  moderationActions   ModerationAction[] @relation("ModeratedUser")
  issuedModerations  ModerationAction[] @relation("ModerationAdmin")
  strikesReceived    UserStrike[]       @relation("StrikeTarget")
  strikesIssued      UserStrike[]       @relation("StrikeAdmin")
  requestFeatureUsages RequestFeatureUsage[]
  reviewedMessageFlags MessageModerationFlag[] @relation("MessageFlagReviewer")
  adminActionLogs      AdminActionLog[] @relation("AdminActionActor")
  emailVerificationCodes EmailVerificationCode[]
  pageFeedbacks        PageFeedback[]

  @@index([email])
  @@index([username])
  @@index([city, district])
}

model EmailVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PageFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  message   String
  pageUrl   String
  userId    String?  @db.Uuid
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AdminActionLog {
  id             String          @id @default(uuid()) @db.Uuid
  adminId        String          @db.Uuid
  action         AdminActionType
  targetUserId   String?         @db.Uuid
  targetRequestId String?        @db.Uuid
  targetOfferId  String?         @db.Uuid
  targetReportId String?         @db.Uuid
  targetMessageId String?        @db.Uuid
  reason         String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  admin User @relation("AdminActionActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetRequestId, createdAt])
  @@index([targetOfferId, createdAt])
}

model ModerationAction {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  adminId   String         @db.Uuid
  type      ModerationType
  reason    String
  startsAt  DateTime       @default(now())
  endsAt    DateTime?
  createdAt DateTime       @default(now())

  user  User @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  admin User @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

model UserStrike {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  adminId   String       @db.Uuid
  level     StrikeLevel
  reason    StrikeReason
  adminNote String?
  status    StrikeStatus @default(ACTIVE)
  startsAt  DateTime     @default(now())
  endsAt    DateTime?
  revokedAt DateTime?
  reportId  String?      @db.Uuid
  messageId String?      @db.Uuid
  requestId String?      @db.Uuid
  offerId   String?      @db.Uuid
  createdAt DateTime     @default(now())

  user    User     @relation("StrikeTarget", fields: [userId], references: [id], onDelete: Restrict)
  admin   User     @relation("StrikeAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  report  Report?  @relation("StrikeReport", fields: [reportId], references: [id], onDelete: SetNull)
  message Message? @relation("StrikeMessage", fields: [messageId], references: [id], onDelete: SetNull)
  request Request? @relation("StrikeRequest", fields: [requestId], references: [id], onDelete: SetNull)
  offer   Offer?   @relation("StrikeOffer", fields: [offerId], references: [id], onDelete: SetNull)

  @@index([userId, level, status, createdAt])
  @@index([adminId, createdAt])
  @@index([reportId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  requests Request[]

  @@index([parentId, isActive])
  @@index([slug])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  slug        String   @unique
  description String?
  brand       String?
  model       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requests Request[]

  @@index([categoryId, isActive])
  @@index([brand, model])
}

model Request {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  productId   String?          @db.Uuid
  categoryId  String?          @db.Uuid
  title       String
  description String?
  minBudget   Decimal?         @db.Decimal(12, 2)
  maxBudget   Decimal?         @db.Decimal(12, 2)
  currency    String           @default("TRY")
  condition   RequestCondition @default(UNKNOWN)
  city        String
  district    String?
  status      RequestStatus    @default(ACTIVE)
  sameDayNeeded Boolean        @default(false)
  preferredFeatures String[]   @default([])
  expiresAt   DateTime?
  featuredUntil DateTime?
  pinnedUntil   DateTime?
  urgentUntil   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  offers        Offer[]
  favorites     FavoriteRequest[]
  conversations Conversation[]
  reports       Report[]          @relation("RequestReport")
  reviews       Review[]
  strikes       UserStrike[]      @relation("StrikeRequest")
  featureUsages RequestFeatureUsage[]

  @@index([status, categoryId, productId, city, createdAt])
  @@index([userId, status, createdAt])
  @@index([expiresAt])
  @@index([status, pinnedUntil, featuredUntil, createdAt])
}

model RequestFeatureUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  requestId     String   @db.Uuid
  feature       String
  durationHours Int
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([requestId, createdAt])
}

model Offer {
  id             String           @id @default(uuid()) @db.Uuid
  requestId      String           @db.Uuid
  sellerId       String           @db.Uuid
  price          Decimal          @db.Decimal(12, 2)
  currency       String           @default("TRY")
  condition      RequestCondition @default(UNKNOWN)
  warrantyType   OfferWarrantyType @default(NONE)
  warrantyMonths Int?
  benefits       String[]         @default([])
  description    String?
  deliveryInfo   String?
  status         OfferStatus      @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  request       Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  reports       Report[]       @relation("OfferReport")
  reviews       Review[]
  strikes       UserStrike[]   @relation("StrikeOffer")

  @@index([requestId, sellerId, status])
  @@index([sellerId, status, createdAt])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  buyerId   String   @db.Uuid
  sellerId  String   @db.Uuid
  requestId String?  @db.Uuid
  offerId   String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  request  Request?  @relation(fields: [requestId], references: [id], onDelete: SetNull)
  offer    Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([buyerId, sellerId, createdAt])
  @@index([requestId, offerId])
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  content        String
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reports      Report[]     @relation("MessageReport")
  strikes      UserStrike[] @relation("StrikeMessage")
  moderationFlags MessageModerationFlag[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageModerationFlag {
  id            String                         @id @default(uuid()) @db.Uuid
  messageId     String                         @db.Uuid
  type          MessageModerationType
  severity      MessageModerationSeverity
  matchedRule   String
  maskedText    String?
  reviewStatus  MessageModerationReviewStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewedById  String?                        @db.Uuid
  adminNote     String?
  createdAt     DateTime                       @default(now())

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("MessageFlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reviewStatus, createdAt])
  @@index([type, reviewStatus, createdAt])
  @@index([messageId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Review {
  id             String   @id @default(uuid()) @db.Uuid
  reviewerId     String   @db.Uuid
  reviewedUserId String   @db.Uuid
  requestId      String?  @db.Uuid
  offerId        String?  @db.Uuid
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  reviewer     User     @relation("ReviewWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser User     @relation("ReviewReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  request      Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  offer        Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([reviewerId, reviewedUserId, requestId])
  @@index([reviewedUserId, createdAt])
  @@index([requestId, offerId])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reportedUserId String?      @db.Uuid
  requestId      String?      @db.Uuid
  offerId        String?      @db.Uuid
  messageId      String?      @db.Uuid
  reason         String
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User     @relation("ReportFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  request      Request? @relation("RequestReport", fields: [requestId], references: [id], onDelete: SetNull)
  offer        Offer?   @relation("OfferReport", fields: [offerId], references: [id], onDelete: SetNull)
  message      Message? @relation("MessageReport", fields: [messageId], references: [id], onDelete: SetNull)
  strikes      UserStrike[] @relation("StrikeReport")

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model FavoriteRequest {
  userId    String   @db.Uuid
  requestId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([userId, requestId])
  @@index([userId, createdAt])
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId, createdAt])
}
